# Cross builds consume generated game code and tools built for the development host.
if(ANDROID AND NOT ANDROID_ABI STREQUAL "arm64-v8a")
    message(FATAL_ERROR "The Android port currently supports arm64-v8a only")
endif()
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
if(NOT RECOMP_ANDROID_DEPENDENCIES_ONLY)
foreach(generated RecompiledFuncs/recomp_overlays.inl
                  RecompiledPatches/patches.c RecompiledPatches/patches_bin.c
                  RecompiledPatches/patches_bin.h
                  RecompiledPatches/recomp_overlays.inl RecompiledPatches/funcs.h
                  rsp/aspMain.cpp)
    if(NOT EXISTS "${CMAKE_SOURCE_DIR}/${generated}")
        message(FATAL_ERROR "Missing ${generated}. Generate game and patch sources on the host first; see android/README.md")
    endif()
endforeach()
file(GLOB android_game_sources "${CMAKE_SOURCE_DIR}/RecompiledFuncs/*.c")
if(NOT android_game_sources)
    message(FATAL_ERROR "RecompiledFuncs is empty. Run the host N64Recomp with us.rev1.toml first")
endif()
endif()
foreach(tool RECOMP_HOST_DXC RECOMP_HOST_FILE_TO_C)
    if(NOT EXISTS "${${tool}}")
        message(FATAL_ERROR "${tool} must name an executable for the build host; see android/README.md")
    endif()
endforeach()
if(RECOMP_IOS)
    set(SDL_SHARED OFF CACHE BOOL "" FORCE)
    set(SDL_STATIC ON CACHE BOOL "" FORCE)
else()
    set(SDL_SHARED ON CACHE BOOL "" FORCE)
    set(SDL_STATIC OFF CACHE BOOL "" FORCE)
endif()
set(SDL_TEST OFF CACHE BOOL "" FORCE)
add_subdirectory(${CMAKE_SOURCE_DIR}/android/deps/SDL ${CMAKE_BINARY_DIR}/SDL)
set(SDL2_INCLUDE_DIRS "${CMAKE_SOURCE_DIR}/android/deps/SDL/include")
set(SDL2_LIBRARIES SDL2::SDL2)
# RT64 uses find_package(SDL2) even when the target is already available.
list(PREPEND CMAKE_MODULE_PATH "${CMAKE_SOURCE_DIR}/android/cmake")
set(FT_DISABLE_ZLIB ON CACHE BOOL "" FORCE)
set(FT_DISABLE_BZIP2 ON CACHE BOOL "" FORCE)
set(FT_DISABLE_PNG ON CACHE BOOL "" FORCE)
set(FT_DISABLE_HARFBUZZ ON CACHE BOOL "" FORCE)
set(FT_DISABLE_BROTLI ON CACHE BOOL "" FORCE)
set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
add_subdirectory(${CMAKE_SOURCE_DIR}/android/deps/freetype ${CMAKE_BINARY_DIR}/freetype)
if(NOT TARGET Freetype::Freetype)
    add_library(Freetype::Freetype ALIAS freetype)
endif()
